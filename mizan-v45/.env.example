# Server-only PBKDF2-SHA256 salted hash, configured as a Sites secret.
# Never put the PIN in client code or NEXT_PUBLIC variables.
RECOMMENDATION_INITIAL_HASH=
RECOMMENDATION_OWNER_EMAIL=

ADMIN_PASSWORD_HASH=

# Gold connectors: server-only. Do not set display approval until rights are verified.
GOLDAPI_KEY=
METALS_DEV_API_KEY=
TWELVE_DATA_API_KEY=
GOLDAPI_DISPLAY_APPROVED=false
METALS_DEV_DISPLAY_APPROVED=false
TWELVE_DATA_GOLD_DISPLAY_APPROVED=false
TWELVE_DATA_GOLD_TROY_OUNCE_VERIFIED=false

# 32-byte random wrapping key (hex), stored as a hosting secret. Do not rotate without migrating stored credentials.
MIZAN_PROVIDER_VAULT_KEY=

# Server-only safety switch. This alone does not register a Cloudflare trigger.
# Keep false until manual limit=5 / idempotency / regression acceptance.
MIZAN_BACKGROUND_CRON_ENABLED=false
