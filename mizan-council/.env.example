# انسخ هذا الملف إلى .env محليًا فقط.
# لا ترفع .env الحقيقي إلى GitHub.

# ─── Local ports ─────────────────────────────
FLOWISE_PORT=3000
LITELLM_PORT=4000

# ─── Images ──────────────────────────────────
# قبل الإنتاج ثبّت tags محددة بدل latest/main-latest بعد اختبارها.
FLOWISE_IMAGE=flowiseai/flowise:latest
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:main-latest

# ─── Databases ───────────────────────────────
FLOWISE_DB_PASSWORD=CHANGE_ME_LONG_RANDOM_FLOWISE_DB_PASSWORD
LITELLM_DB_PASSWORD=CHANGE_ME_LONG_RANDOM_LITELLM_DB_PASSWORD

# ─── Flowise credential encryption ───────────
# استخدم قيمة عشوائية طويلة ولا تشاركها مع مفاتيح المزودين.
FLOWISE_SECRETKEY=CHANGE_ME_LONG_RANDOM_FLOWISE_SECRET

# ─── LiteLLM gateway ─────────────────────────
LITELLM_MASTER_KEY=CHANGE_ME_SK_MIZAN_COUNCIL_LONG_RANDOM
DATABASE_URL=postgresql://litellm:CHANGE_ME_LONG_RANDOM_LITELLM_DB_PASSWORD@litellm-db:5432/litellm

# ─── Provider API keys ───────────────────────
# ضع فقط المفاتيح الفعلية التي تريد استخدامها.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ─── Optional model overrides ────────────────
# تحقق من أسماء النماذج المتاحة في حسابك قبل الإنتاج.
# تُستخدم هذه القيم كمرجع تشغيلي لك، ويجب أن يطابقها litellm_config.yaml.
OPENAI_COUNCIL_MODEL=openai/gpt-5
ANTHROPIC_COUNCIL_MODEL=anthropic/claude-sonnet-4-5-20250929
GEMINI_COUNCIL_MODEL=gemini/gemini-2.5-pro
DEEPSEEK_COUNCIL_MODEL=deepseek/deepseek-chat
